.DS_Store
*.swp
.*.swp
.magic-token
.magic-apps.json
.cache/
__pycache__/
*.pyc

# Local Office temporary files
~$*

# Source decks can easily exceed GitHub's 100MB single-file limit.
# Keep the generated HTML/assets in dist, but store original PPTX files elsewhere
# or use Git LFS if you really need to version them.
*.ppt
*.pptx

# Local screenshots and smoke-test artifacts
*.log

# Generated delivery runs. Keep the delivery contract, not every local run.
deliveries/*
!deliveries/README.md

# Generated deck exports and Magic publishing artifacts that are not canonical
# examples. Keep source builders/scripts in git and regenerate these locally.
dist/assets/one-store-one-group/
dist/assets/one-store-one-group-magic/
dist/feishu-bot-chat-slide.html
dist/feishu-bot-chat-slide.magic.html
dist/one-store-one-group-magic-assets.json
dist/why-skill-why-feishu-feishu.html
dist/why-skill-why-feishu-feishu.texts.md

# Business-specific product mock prototypes stay local unless promoted to docs.
product-mocks/feishu-bot-chat-prototype.html
scripts/build_feishu_one_store_magic.js
scripts/build_why_skill_feishu_deck.mjs

# Browser-extracted real product mock artifacts.
# These can contain computed styles from logged-in Feishu/Lark pages and should
# stay local unless explicitly sanitized for an internal-only repo.
product-mocks/generated/
product-mocks/captures/

# Oversized offline artifact. Regenerate with:
# python3 scripts/build_magic_preview.py
dist/lark-deckkit-preview.html
